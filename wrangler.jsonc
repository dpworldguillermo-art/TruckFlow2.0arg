{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truckflow-arg",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/live",
      "/live.html",
      "/live_previous",
      "/live_previous.html",
      "/users",
      "/users.html",
      "/admin",
      "/admin.html",
      "/data/*",
      "/login"
    ],
    "html_handling": "none"
  },
  // IMPORTANTE: crea un KV propio llamado ARG_DATA y reemplaza el ID de ceros por su Namespace ID real.
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "00000000000000000000000000000000"
    }
  ],
  "secrets": {
    "required": [
      "SYNC_TOKEN",
      "AUTH_SECRET",
      "ADMIN_USER",
      "ADMIN_PASSWORD"
    ]
  }
}
